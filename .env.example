# Server-only — used by next.config.ts's /api rewrite and by apiClient.ts
# during SSR. Points directly at the backend on the private network
# (e.g. http://backend:8000 in docker-compose; http://localhost:8000 for
# local dev running backend outside docker).
BACKEND_INTERNAL_URL=http://localhost:8000

# Optional override for the browser's API base path. Leave unset in normal
# deployments — apiClient.ts then defaults to the same-origin "/api" rewrite,
# so the backend is never called directly from the browser and never needs
# to be public.
# NEXT_PUBLIC_API_BASE_URL=/api

NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Must match backend/.env's AUTH_COOKIE_SECRET exactly — frontend/lib/auth/session.ts
# verifies the legacy twistfit_session cookie that the backend now issues.
AUTH_COOKIE_SECRET=change-me-in-production
